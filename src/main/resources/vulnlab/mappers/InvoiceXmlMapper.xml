<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vulnlab.common.InvoiceXmlMapper">

  <!-- ${sort} est recopié dans la requête : injection (ORDER BY ne peut pas être paramétré avec #{}) -->
  <select id="sortedInvoices" resultType="map">
    SELECT * FROM invoice ORDER BY ${sort}
  </select>

  <!-- #{customer} est un paramètre lié : sûr -->
  <select id="invoicesOf" resultType="map">
    SELECT * FROM invoice WHERE customer = #{customer}
  </select>

</mapper>
